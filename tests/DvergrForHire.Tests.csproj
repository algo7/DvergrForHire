<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs DvergrForHire's Unity-free code (settings tables, hire rules, multiplayer rules) against the game's own types
    from assembly_valheim.dll, outside the game. Everything that needs a live Unity engine is tested in game.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableDefaultItems>false</EnableDefaultItems>
    <!-- The game assemblies target .NET Framework; they load fine for reflection and plain data classes. -->
    <NoWarn>$(NoWarn);NU1701;MSB3277</NoWarn>
    <ValheimDir Condition="'$(ValheimDir)' == ''">$(HOME)/.local/share/Steam/steamapps/common/Valheim</ValheimDir>
    <ManagedDir Condition="'$(ManagedDir)' == ''">$(ValheimDir)/valheim_Data/Managed</ManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../src/FieldSetting.cs" />
    <Compile Include="../src/DvergrSettings.cs" />
    <Compile Include="../src/HireRules.cs" />
    <Compile Include="../src/MultiplayerRules.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="assembly_valheim">
      <HintPath>$(ManagedDir)/assembly_valheim.dll</HintPath>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(ManagedDir)/assembly_utils.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)/UnityEngine.CoreModule.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
